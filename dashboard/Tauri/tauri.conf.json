{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmur Dashboard",
  "version": "1.9.0",
  "identifier": "com.murmur.dashboard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Murmur Dashboard",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "trayIcon": {
      "id": "murmur-tray",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'"
    }
  }
}